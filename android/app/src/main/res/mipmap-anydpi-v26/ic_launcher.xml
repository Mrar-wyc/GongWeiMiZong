<?xml version="1.0" encoding="utf-8"?>
<!--
  API 26+ 的自适应图标：前景是那枚朱砂方印（drawable/ic_launcher.xml），
  底色是同一个朱砂（color/ic_launcher_background）。系统按自己的形状裁切。

  注意清单里 icon 指的是 @drawable/ic_launcher（那份矢量在所有 API 上都画得出来），
  这份 anydpi-v26 是给「会自动找 mipmap/ic_launcher」的启动器留的。
-->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@color/ic_launcher_background" />
    <foreground android:drawable="@drawable/ic_launcher" />
</adaptive-icon>
